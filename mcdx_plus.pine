//@version=6
indicator(title = 'MCDX Plus - revision 12 (1Nov25) - TV publication', shorttitle = "MCDX Master", format = format.price, precision = 2, overlay = false)

/////////////////////////////////Revision/////////////////////////////////
//revision 1, 18Jul21, first published to Tradingview
//revision 2, 2Aug21, added moving average of profitable, float and locked chips 
//revision 3, 12Aug21, added oversold and overbought 
//revision 4, 15Aug21, fixed the bugs of floating chips bar go beyond 100%
//revision 5, 4Oct21, adjustable table text/size, adjustable locations of bottom catch/oversold/overbought alerts, cosmetic setting arrangement
//revision 6, 20Oct21, adding source per user request. Pinescript now uses version 5.
//revision 7, 21Oct21, fixed the bugs on source input, added open, HL2, HLC3, OHLC4
//revision 8, 24Oct21, allow source input to include user's indicator(not recommended as scripts is developed based on closing price), added fund simulation
//revision 9, 4Apr22, Update on Input Setting to ease user input. 
//              Tooltip on Table added. User can move the cursor to each Table Cell to show the description. 
//              Added Auto MCDX options, enable MCDX starts to show on 3rd day from IPO. Removed MCDX 34-Day options since Auto MCDX added. 
//              User can use Manual Input to input the MCDX Length as they see fit. Alert will show if user input unacceptable length. 
//              User can turn on All Chips or Profitable Chips Only, Float Chip Only, Locked Only
//              User can turn on Simple Moving Average of Profitable Chips, Float Chips, Locked Chips as they see fit. 
//              Default show Simple Moving Average of Profitable and Locked Chips.
//              Golden Cross, Death Cross Added. Text Size and Location Adjustable.  Alert Conditions Added
//              Bottom Catch, Oversold, Overbought Alert Text Size and Location Adjustable. Alert Conditions Added
//              Bar Number Tooltip of Current Bar. User can move the cursor to current bar to show the bar number. 
//revision 10, add alert conditions of Profitable Chips crossover SMA of Profitable Chips. User can choose the alert at the Creat Alert.  
//revision 11, Jul25, convert to version 6, 
//                    add alerts & alert conditions for Fund crossover SMA PC and Fund crossover SMA LC per user Sakank input
//                    add alerts & chips behavior to table
//revision 12, upgrade computation logic, add double dragon alerts, add MCD, keep revision 11 for reference 

/////////////////////////////////Input///////////////////////////////
gr0 = 'Table'
ind = input.bool(title = 'Show Table', defval = true, inline = '1a', group = gr0)
text_size = input.string(title = 'Table Text Size:', options = ['AUTO', 'TINY', 'SMALL', 'NORMAL', 'LARGE', 'HUGE'], defval = 'SMALL', inline = '1b', group = gr0)
w = input.int(title = '/ Table Width:', defval = 12, minval = 8, maxval = 20, inline = '1b', group = gr0)

gr1 ='MCDX/MCD & Revision'
mcdx_mcd = input.string(title = 'MCDX or MCD', options = ['MCDX', 'MCD'], defval = 'MCDX', group = gr1)
mcdx_rev = input.string(title = 'MCDX or MCD Revision =', options = ['12','11'], defval = '12', group = gr1,tooltip ='MCD starts with Revision 12'+'\n MCDX has option of 12 or 11')

gr2 = 'MCDX/MCD Source and Length'
mcdx_source = input.source(title = 'MCDX Source =', defval = close, inline = '2', tooltip = 'Advisible to use Close', group = gr2)
mcdx_length = input.string(title = 'MCDX Length =', options = ['Auto', '34-bar', '50-bar', '100-bar', 'Manual Input'], defval = 'Auto', inline = '2a', group = gr2)
manual_len = input.int(title = 'Manual Input = ', defval = 100, minval = 3, inline = '2a', tooltip = 'Use Auto for new stocks, use 100-bar for mature stocks', group = gr2)

gr3 = 'Plot for Profit, Float, Locked Chips'
all_show = input.bool(title = 'All', defval = true, inline = '3a', group = gr3, tooltip = 'Default will show all')
pc_show = input.bool(title = 'PC only', defval = false, inline = '3b', group = gr3, tooltip = 'PC=Profitable Chips %')
fc_show = input.bool(title = 'FC only', defval = false, inline = '3c', group = gr3, tooltip = 'FC=Float Chips %')
lc_show = input.bool(title = 'LC only', defval = false, inline = '3d', group=gr3, tooltip = 'LC = Locked Chips')

gr4 = 'SMA Length Input and Plot for Profit, Float, Locked Chips'
sma_pc_len = input.int(title = 'SMA PC Length = ', defval = 10, minval = 1, inline = '4a', group = gr4)
sma_pc_show = input.bool(title = 'SMA PC Plots', defval = true, inline = '4a', tooltip = 'SMA = Simple Moving Average, Default Length =10, PC = Profitable Chips', group = gr4)
sma_fc_len = input.int(title = 'SMA FC Length = ', defval = 10, minval = 1, inline = '4b', group = gr4)
sma_fc_show = input.bool(title = 'SMA FC Plots', defval = false, inline = '4b', tooltip = 'SMA = Simple Moving Average, Default Length =10, FC = Float Chips. Click to show plot', group = gr4)
sma_lc_len = input.int(title = 'SMA LC Length = ', defval = 10, minval = 1, inline = '4c', group = gr4)
sma_lc_show = input.bool(title = 'SMA LC Plots', defval = true, inline = '4c', tooltip = 'SMA=Simple Moving Average, Default Length =10, LC = Locked Chips', group = gr4)

gr5 = 'Golden Cross, Death Cross of SMA PC and SMA LC'
gc_show = input.bool(title = 'GC,', defval = true, inline = '5a', group = gr5)
gc_label_size = input.string(title = 'Text Size:', options = ['NONE', 'TINY', 'SMALL', 'NORMAL', 'LARGE', 'HUGE'], defval = 'NORMAL', inline = '5a', group = gr5)
gc_label_offset_v = input.int(title = 'Up/Down', defval = 0, step = 1, inline = '5a', group = gr5)
gc_icon_show = input.bool(title = 'Icon', defval = false, tooltip = 'Golden Cross of SMA Profitable Chips and SMA Locked Chips', inline = '5a', group = gr5)
dc_show = input.bool(title = 'DC,', defval = true, inline = '5b', group = gr5)
dc_label_size = input.string(title = 'Text Size:', options = ['NONE', 'TINY', 'SMALL', 'NORMAL', 'LARGE', 'HUGE'], defval = 'NORMAL', inline = '5b', group = gr5)
dc_label_offset_v = input.int(title = 'Up/Down', defval = 0, step = 1, inline = '5b', group = gr5)
dc_icon_show = input.bool(title = 'Icon', defval = false, tooltip = 'Death Cross of SMA Profitable Chips and SMA Locked Chips', inline = '5b', group = gr5)

gr6 = 'Alerts : Bottom Catch (BC) / Oversold (OS) / Overbought (OB)'
bc_show = input.bool(title = 'Bottom Catch,', defval = true, inline = '6a', group = gr6)
bc_label_size = input.string(title = 'Text Size:', options = ['NONE', 'TINY', 'SMALL', 'NORMAL', 'LARGE', 'HUGE'], defval = 'SMALL', inline = '6a', group = gr6)
bc_label_offset_v = input.int(title = 'Up/Down', defval = 20, step = 1, inline = '6a', group = gr6)
bc_icon_show = input.bool(title = 'Icon', defval = false, tooltip = 'Bottom Catch', inline = '6a', group = gr6)
os_show = input.bool(title = 'OS,', defval = true, inline = '6b', group = gr6)
os_label_size = input.string(title = 'Text Size:', options = ['NONE', 'TINY', 'SMALL', 'NORMAL', 'LARGE', 'HUGE'], defval = 'SMALL', inline = '6b', group = gr6)
os_label_offset_v = input.int(title = 'Up/Down', defval = 10, step = 1, inline = '6b', group = gr6)
os_icon_show = input.bool(title = 'Icon', defval = false, tooltip = 'Oversold', inline = '6b', group = gr6)
ob_show = input.bool(title = 'OB,', defval = true, inline = '6c', group = gr6)
ob_label_size = input.string(title = 'Text Size:', options = ['NONE', 'TINY', 'SMALL', 'NORMAL', 'LARGE', 'HUGE'], defval = 'SMALL', inline = '6c', group = gr6)
ob_label_offset_v = input.int(title = 'Up/Down', defval = 80, step = 1, inline = '6c', group = gr6)
ob_icon_show = input.bool(title = 'Icon', defval = false, tooltip = 'Overbought', inline = '6c', group = gr6)

gr7 = 'Funds Simulation Plot & Alerts'
fundsim_show = input.bool(title = 'Fund Simulation, ', defval = false, inline = '7', group = gr7)
fundsim_color = input.color(title = 'Color =', defval = color.orange, inline = '7', group = gr7)
fundsim_co_smapc_show = input.bool(title = 'Fund crossover SMA PC Alert, FP ', defval = false, inline = '7b', group = gr7, tooltip='FP = Fund crossover SMA PC(Profitable Chips Simple Moving Average)')
fundsim_co_smalc_show = input.bool(title = 'Fund crossover SMA LC Alert, FL', defval = false, inline = '7c', group = gr7, tooltip='FL =Fund crossover SMA LC(Locked Chips Simple Moving Average)')

gr8 = 'Bands'
band25_show = input.bool(title = '25', defval = true, inline = '8', group = gr8)
band50_show = input.bool(title = '50', defval = true, inline = '8', group = gr8)
band75_show = input.bool(title = '75', defval = true, inline = '8', group = gr8)

/////////////////////////////////MCDX or MCD///////////////////////////////
mcdx_plot = mcdx_mcd == 'MCDX' ? true : false 
mcd_plot = mcdx_mcd == 'MCD' ? true : false 

/////////////////////////////////MCDX Revision ///////////////////////////////
mcdx12 = mcdx_rev == '12' ? true : false 
mcdx11 = mcdx_rev == '11' ? true : false 

//////////////////////////////////////////Function : converting value to string////////////////////////////////////////
NoDecimal(float x) => str.tostring(x, "#")          // 0 decimals
OneDecimal(float x) => str.tostring(x, "0.0")        // 1 decimal
TwoDecimal(float x) => str.tostring(x, "0.00")       // 2 decimals
ThreeDecimal(float x) => str.tostring(x, "0.000")      // 3 decimals

/////////////////////////////////Functions///////////////////////////////
clamp(x, minv, maxv) =>
    math.max(minv, math.min(maxv, x))

range_step(N) =>
    hi = ta.highest(high, N)
    lo = ta.lowest(low,  N)
    rng = hi - lo
    step = (rng == 0 ? 0.01 : rng) / 100.0
    [lo, hi, step]

pct_to_price(pct, lo, hi) =>
    lo + (hi - lo) * clamp(pct, 0, 100) / 100.0

fmcdx(X, N) =>
    lo = ta.lowest(low, N), hi = ta.highest(high, N)
    step = ((hi - lo) == 0 ? syminfo.mintick : (hi - lo)) / 100.0
    clamp((X - lo) / step, 0, 100)

fmcd(Xf, Nf) =>
    pcraw = float(na)
    lol_nf = ta.lowest(low,Nf)
    hoh_nf = ta.highest(high,Nf)
    rng = math.max(hoh_nf-lol_nf,0.01)//avoid division by zero
    // step  = (hoh_nf - lol_nf) / 100
    step  = rng / 100
    pcraw := (Xf - lol_nf)/step
    al = bar_index<34 ? 0.05 : bar_index<=50 ? 0.04 : bar_index<=100 ? 0.03 : 0.025
    pcm = 0.0
    pcm := al * pcraw + (1 - al) * pcraw[1]
    clamp(pcm,0,100)

/////////////////////////////////Manual Length Label Alert///////////////////////////////
barI = bar_index + 1
barN = barI + 1
manual_len_violate = manual_len > barI
violate_label_string = 'Please input Manual Length < ' + str.tostring(barN, '#')
violate_label = mcdx_length == 'Manual Input' and manual_len_violate ? label.new(bar_index + 3, 50, text = violate_label_string, textcolor = color.red, color = color.red, style = label.style_flag, textalign = text.align_center, size = size.large) : na
label.delete(violate_label[1])

/////////////////////////////////Bands///////////////////////////////
band75 = hline(band75_show ? 75 : na, title = '75 Profitable Zone', color = color.black, linestyle = hline.style_dashed)
band50 = hline(band50_show ? 50 : na, title = '50 Up/Down Zone', color = color.black, linestyle = hline.style_dashed)
band25 = hline(band25_show ? 25 : na, title = '25 Accumulation Zone', color = color.black, linestyle = hline.style_dashed)

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//MCDX Revision 12
//////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////

//MCDX Source & Length for Computation ///////////////////////////////////////
auto_lenr = 3
for i = 3 to 100 by 1
    if bar_index == i
        auto_lenr := i
        break
    if bar_index >= 100
        auto_lenr := 100
        break

int mcdx_lenr = 3
mcdx_lenr := mcdx_length == 'Auto' ? auto_lenr : mcdx_length == '34-bar' ? 34 : mcdx_length == '50-bar' ? 50 : mcdx_length == '100-bar' ? 100 : mcdx_length == 'Manual Input' ? manual_len : na
mcdx_srcr = mcdx_source
Nr = mcdx_lenr

//////////////////////////////////////////MCDX12 Length Label/////////////////////////////////////////
// bar_index_stg = bar_index <100 ? 'New'+'\nStocks' : bar_index>=100 ? 'Mature'+'\nStocks' : 'na'
mcdx_lenr_string = mcdx_length == 'Auto' ? 'MCDX+12' + '\n Auto ' + NoDecimal(mcdx_lenr) + ' bars' + '\nBI ='+ NoDecimal(bar_index):
 (mcdx_length =='34-bar' or  mcdx_length =='50-bar' or mcdx_length == '100-bar' or mcdx_length =='Manual Input')? 'MCDX+12' + '\n' + NoDecimal(mcdx_lenr) + ' bars' + '\nBI='+ NoDecimal(bar_index): na 

mcdx_labelr = mcdx12== true and mcdx_plot == true?label.new(bar_index+7,50,text=mcdx_lenr_string, color=color.new(color.white,100), style=label.style_none, textcolor=color.black, textalign = text.align_center, size=size.small) :na
label.delete(mcdx_labelr[1])

/////////////////////////////////Profit Chips ///////////////////////////////
pcr_mult = bar_index <= 100 ? 0.98 : 0.96
Xpr = mcdx_srcr*pcr_mult
pcr = fmcdx(Xpr, Nr)
pcr_val = pcr //for sma pcr
mcdx_val = pcr_val 
profit_chipsr_plot = pcr_val //for plotting
pcr_stg = OneDecimal(pcr_val)
sma_pcr = ta.sma(pcr_val, sma_pc_len)
sma_pcr_val = sma_pcr
sma_pcrmcdx_val = ta.sma(pcr_val,10) //for double dragon computation 
pc_colorr = pcr_val >= sma_pcr ? color.new(#EB4C42, 10) : color.new(#FFB7C5, 0) //for plotting 
mcdx12_pc = pcr //for fund crossover 

//////////////////////////////////Float Chips ///////////////////////////////
fcr_mult = bar_index <=100 ? 1.02 : 1.04 
Xfur = mcdx_srcr*fcr_mult
fcur = fmcdx(Xfur,Nr) 
fcur_val = fcur 
float_chipsr_plot = fcur_val //for plotting 
fcr_color = (all_show or fc_show)? color.new(#FFFF00, 0) : lc_show ? color.white : na
fclr_val = pcr < 0 ? 0 : pcr > 100 ? 100 : pcr
fcr_val = fcur_val - fclr_val //for sma
fcr_stg = OneDecimal(fcr_val)
float_chipsr = fcr_val
sma_fcr = ta.sma(fcr_val, sma_fc_len)
sma_fcr_val = sma_fcr

////////////////////////////////Locked Chips /////////////////////////////
lcr = int(na)
for i = 3 to 100 by 1
    if bar_index == i - 1 and mcdx_length == 'Auto'
        lcr := 100
        break
    if bar_index >= 100 and mcdx_length == 'Auto'
        lcr := 100
        break    
    if bar_index >= 34 - 1 and mcdx_length == '34-bar'
        lcr := 100
        break    
    if bar_index >= 50 - 1 and mcdx_length == '50-bar'
        lcr := 100
        break
    if bar_index >= 100 - 1 and mcdx_length == '100-bar'
        lcr := 100
        break
    if bar_index >= manual_len - 1 and mcdx_length == 'Manual Input'
        lcr := 100
        break

locked_chipsr_plot = lcr //for plotting 
lcr_val = 100 - fcur_val //for sma 
lcr_stg = OneDecimal(lcr_val)
locked_chipsr = lcr_val //for sma 
sma_lcr = ta.sma(lcr_val, sma_lc_len)
sma_lcr_val = sma_lcr

///////////////////////////////////////MCDX R12 Plots/////////////////////////////////////
plot((all_show or lc_show) and mcdx12== true and mcdx_plot == true ? locked_chipsr_plot : na, title = 'Locked Chips,MCDX+12', color = color.new(#39FF14, 0), linewidth = 10, style = plot.style_columns)
plot((all_show or fc_show or lc_show) and mcdx12== true  and mcdx_plot == true ?float_chipsr_plot:na, title='Float Chips, MCDX+12', color=fcr_color , linewidth=10, style=plot.style_columns)
plot((all_show or pc_show) and mcdx12== true  and mcdx_plot == true? profit_chipsr_plot : na, title = 'Profit Chips, MCDX+12', color = pc_colorr, linewidth = 10, style = plot.style_columns)

///////////////////////////////////////MCDX R12 Moving Average Plots/////////////////////////////////////
plot(sma_pc_show and mcdx12== true and mcdx_plot == true ? sma_pcr : na, title = 'Profit Chips SMA, MCDX+12', color = color.maroon)
plot(sma_fc_show and mcdx12== true and mcdx_plot == true  ? sma_fcr:na, title='Float Chips SMA, MCDX+12', color=color.new(#FFAE42, 0))
plot(sma_lc_show and mcdx12== true and mcdx_plot == true ?sma_lcr:na, title='Locked Chips SMA, MCDX+12', color=color.new(#50C878, 0))

////////////////////////////////////////PC crossover SMA-PC Alert Condtions //////////////////////////////////////
pcr_co_smapcr = ta.crossover(pcr, sma_pcr) and sma_lcr > sma_pcr
pc_co_smapcr_val = pcr_co_smapcr ? pcr : na
alertcondition(pcr_co_smapcr, title = 'MCDX+12: PC crossover SMA PC', message = 'MCDX+12 : PC crossover SMA PC')

///////////////////////////////Golden Cross////////////////////////////
mcdx12_gc = ta.crossover(sma_pcr, sma_lcr)
mcdx12_gc_val =mcdx12== true and mcdx_plot == true and  mcdx12_gc ? sma_pcr : na
plot(mcdx12_gc_val, title="Golden Cross Bar, MCDX+12", style=plot.style_columns, linewidth=2, color=color.purple)

gc1r = switch gc_label_size
    'TINY'   => size.tiny
    'SMALL'  => size.small
    'NORMAL' => size.normal
    'LARGE'  => size.large
    'HUGE'   => size.huge
    => size.auto

gcr_label = gc_show and mcdx12_gc and mcdx12== true and mcdx_plot == true? label.new(bar_index, sma_pcr, text = 'G'+'\nC', color = color.black, style = label.style_none, textcolor = color.black, textalign = text.align_center, size = gc1r) : na
label.set_x(gcr_label, bar_index)
label.set_y(gcr_label, sma_pcr + gc_label_offset_v)
label.set_tooltip(gcr_label, 'Golden Cross')
plotshape(gc_icon_show and mcdx12== true and mcdx_plot == true? mcdx12_gc_val : na, title = 'GC Icon MCDX+12', style = shape.cross, location = location.absolute, color = color.black, text = '', size = size.tiny)

gcr_chartline = mcdx12 == true and mcdx12_gc and mcdx_plot == true? line.new(bar_index, close, bar_index+20, close, color=color.purple, width=2,  force_overlay = true) :na

var label gcr_chartlabel2 = na
if mcdx12 == true and mcdx12_gc and mcdx_plot == true
    // Delete previous label if it exists
    if not na(gcr_chartlabel2)
        label.delete(gcr_chartlabel2)
    // Create the latest label with text
    gcr_chartlabel2 := label.new(bar_index, low, text = 'G'+'\nC',color = color.new(color.purple,80), style = label.style_label_up, textcolor = color.black,  textalign = text.align_left, size = size.small, force_overlay = true)

///////////////////////////////Death Cross////////////////////////////
mcdx12_dc = ta.crossunder(sma_pcr, sma_lcr)
mcdx12_dc_val = mcdx12== true and mcdx_plot == true and mcdx12_dc ? sma_pcr : na
plot(mcdx12_dc_val, title="Death Cross Bar, MCDX+12", style=plot.style_columns, linewidth=2, color=color.black)

dc1r = switch dc_label_size
    'TINY'   => size.tiny
    'SMALL'  => size.small
    'NORMAL' => size.normal
    'LARGE'  => size.large
    'HUGE'   => size.huge
    => size.auto

dcr_label = dc_show and mcdx12_dc and mcdx12== true and mcdx_plot == true ? label.new(bar_index, sma_pcr, text = 'D'+'\nC', color = color.black, style = label.style_none, textcolor = color.black, textalign = text.align_center, size = dc1r) : na
label.set_x(dcr_label, bar_index)
label.set_y(dcr_label, sma_pcr + dc_label_offset_v)
label.set_tooltip(dcr_label, 'Death Cross')
plotshape(dc_icon_show and mcdx12== true and mcdx_plot == true? mcdx12_dc_val : na, title = 'DC Icon MCDX+12', style = shape.xcross, location = location.absolute, color = color.black, text = '', size = size.tiny)

////////////////////////////////////////Golden Cross, Death Cross Alerts ////////////////////////////////////////
//notes : alertcondition allows users to set alert at the alert icon
alertcondition(mcdx12_gc, title = 'MCDX+12 : Golden Cross', message = 'MCDX+12: Golden Cross')
alertcondition(mcdx12_dc, title = 'MCDX+12 : Death Cross', message = 'MCDX+12 : Death Cross')

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//MCD Revision 12 (start with Revision 12, 1Nov25)
//////////////////////////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////////////////////////

//MCD Length Label///////////////////////////////////////
mcd_lenr_string = mcdx_length == 'Auto' ? 'MCD 12' + '\n Auto ' + NoDecimal(mcdx_lenr) + ' bars' + '\nBI ='+ NoDecimal(bar_index):
 (mcdx_length =='34-bar' or  mcdx_length =='50-bar' or mcdx_length == '100-bar' or mcdx_length =='Manual Input')? 'MCD 12' + '\n' + NoDecimal(mcdx_lenr) + ' bars' + '\nBI='+ NoDecimal(bar_index): na 

mcd_labelr = mcd_plot == true?label.new(bar_index+7,50,text=mcd_lenr_string, color=color.new(color.white,100), style=label.style_none, textcolor=color.black, textalign = text.align_center, size=size.small) :na
label.delete(mcd_labelr[1])

//////////////////////////////////////////MCD Profit Chips///////////////////////////////////////
mcd_pcr_mult  = bar_index <= 100 ? 0.96 : 0.94   
Xmcdr_pc = mcdx_srcr*mcd_pcr_mult
mcdr_pc = fmcd(Xmcdr_pc,Nr)
mcdr_pc_val  = mcdr_pc
mcdr_pc_plot = mcdr_pc_val //for plotting
mcdr_pc_stg = OneDecimal(mcdr_pc_val)
mcdr_pc_sma = ta.sma(mcdr_pc_val,10)
mcdr_pc_color = mcdr_pc_val >= mcdr_pc_sma ? color.new(#EB4C42, 10) : color.new(#FFB7C5, 0) //for plotting 
mcd_pc = mcdr_pc //for fund crossover, ob, os, bc  
mcd_pc_sma = ta.sma(mcdr_pc_val,10) //for ob, os, bc
mcd_pc_sma_val = ta.sma(mcdr_pc_val,10) //for classification 

//mcd support price & label 
[loN, hiN, _] = range_step(Nr)
mcd_price          = pct_to_price(mcdr_pc_val,loN, hiN)
mcd_price_stg = 'mcd support: '+ThreeDecimal(mcd_price)
mcd_line = mcd_plot == true ?line.new(bar_index, mcd_price, bar_index+10, mcd_price, color=color.green, width=2, force_overlay = true) : na 
line.delete(mcd_line[1])
mcd_line_label = mcd_plot == true  ? label.new(bar_index+10,mcd_price,text=mcd_price_stg, color=color.new(color.white,100), style=label.style_none, textcolor=color.black, textalign = text.align_left, size=size.small, force_overlay=true) :na
label.delete(mcd_line_label[1])

//////////////////////////////////////////MCD Float Chips/////////////////////////////////////////
//MCD FC
mcd_fcur_mult = bar_index <=100 ? 1.03 : 1.05 
Xmcdr_fcur = mcdx_srcr*mcd_fcur_mult
mcdr_fcur = fmcd(Xmcdr_fcur,Nr)
mcdr_fcur_val = clamp(mcdr_fcur, 0, 100)
mcdr_fc_plot = mcdr_fcur_val //for plotting
mcdr_fclr_val = mcdr_pc <0 ? 0 : mcdr_pc>100 ? 100 : mcdr_pc
mcdr_fc_val = mcdr_fcur_val - mcdr_fclr_val //for sma 
mcdr_fc_stg = OneDecimal(mcdr_fc_val)
mcdr_fc_color = (all_show or fc_show)? color.new(#FFFF00, 0) : lc_show ? color.white : na
mcd_fc = mcdr_fc_val
mcd_fc_sma_val  = ta.sma(mcdr_fc_val,10)

//////////////////////////////////////////MCD Lock Chips///////////////////////////////////////
mcdr_lc_val = 100 - mcdr_fcur_val 
mcdr_lc_stg = OneDecimal(mcdr_lc_val)
mcdr_lc = mcdr_lc_val
mcdr_lc_sma = ta.sma(mcdr_lc_val,10) //for plots
mcdr_lc_plot = lcr
mcd_lc = mcdr_lc_val //for ob, os, bc 
mcd_lc_sma_val = ta.sma(mcdr_lc_val,10) // for Classification

///////////////////////////////////////MCD Plot/////////////////////////////////////
plot((all_show or lc_show) and mcd_plot == true ? mcdr_lc_plot : na, title = 'Locked Chips, MCD12', color = color.new(#39FF14, 0), linewidth = 10, style = plot.style_columns)
plot((all_show or fc_show or lc_show) and  mcd_plot == true ?mcdr_fc_plot:na, title='Float Chips, MCD12', color=mcdr_fc_color , linewidth=10, style=plot.style_columns)
plot((all_show or pc_show) and mcd_plot == true? mcdr_pc_plot : na, title = 'Profit Chips, MCD12', color = mcdr_pc_color, linewidth = 10, style = plot.style_columns)

///////////////////////////////////////MCD Moving Average Plots/////////////////////////////////////
plot(sma_pc_show and mcd_plot == true ? mcdr_pc_sma : na, title = 'Profit Chips SMA, MCD12', color = color.maroon)
plot(sma_lc_show and mcd_plot == true ? mcdr_lc_sma :na, title='Locked Chips SMA, MCD12', color=color.new(#50C878, 0))

///////////////////////////////Golden Cross////////////////////////////
mcd_gc = ta.crossover(mcdr_pc_sma, mcdr_lc_sma)
mcd_gc_val = mcd_plot == true and  mcd_gc ? mcdr_pc_sma : na
plot(mcd_gc_val, title="Golden Cross Bar, MCD12", style=plot.style_columns, linewidth=2, color=color.purple)

mcdr_gc1r = switch gc_label_size
    'TINY'   => size.tiny
    'SMALL'  => size.small
    'NORMAL' => size.normal
    'LARGE'  => size.large
    'HUGE'   => size.huge
    => size.auto

mcdgcr_label = gc_show and mcd_gc and mcd_plot == true? label.new(bar_index, mcdr_pc_sma, text = 'G'+'\nC', color = color.black, style = label.style_none, textcolor = color.black, textalign = text.align_center, size = mcdr_gc1r) : na
label.set_x(gcr_label, bar_index)
label.set_y(gcr_label, sma_pcr + gc_label_offset_v)
label.set_tooltip(gcr_label, 'Golden Cross')

///////////////////////////////Death Cross////////////////////////////
mcd_dc = ta.crossunder(mcdr_pc_sma, mcdr_lc_sma)
mcd_dc_val = mcd_plot == true  and mcd_dc ? mcdr_pc_sma: na
plot(mcd_dc_val, title="Death Cross Bar, MCD12", style=plot.style_columns, linewidth=2, color=color.black)

mcdr_dc1r = switch dc_label_size
    'TINY'   => size.tiny
    'SMALL'  => size.small
    'NORMAL' => size.normal
    'LARGE'  => size.large
    'HUGE'   => size.huge
    => size.auto

mcdr_dcr_label = dc_show and mcd_plot == true  and mcd_dc  ? label.new(bar_index, mcdr_pc_sma, text = 'D'+'\nC', color = color.black, style = label.style_none, textcolor = color.black, textalign = text.align_center, size = mcdr_dc1r) : na
label.set_x(dcr_label, bar_index)
label.set_y(dcr_label, sma_pcr + dc_label_offset_v)
label.set_tooltip(dcr_label, 'Death Cross')

///////////////////////////////////////Double Dragon R12//////////////////////////////////////
mcd_dd_con1 = mcdr_pc_val > mcdr_pc_sma
mcd_dd_con2 = close>open
mcd_dd_con3 = ta.crossover( mcdr_pc_val, 75)
mcd_dd_con4 =  mcdr_pc_val[1]<75 and  mcdr_pc_val>75
mcd_dd_con = mcd_dd_con1 and mcd_dd_con2 and mcd_dd_con3 and mcd_dd_con4

mcdx_dd_con1 = pcrmcdx_val>sma_pcrmcdx_val
mcdx_dd_con2 = close>open
mcdx_dd_con3 = ta.crossover(pcrmcdx_val,75)
mcdx_dd_con4 = pcrmcdx_val[1]<75 and pcrmcdx_val>75 
mcdx_dd_con = mcdx_dd_con1 or mcdx_dd_con2

mcdx_chart_dd = mcd_dd_con and mcdx_dd_con
mcdx_chart_dd_val = mcdx12==true and mcdx_chart_dd and mcdx_plot == true? 75 : na 
plot(mcdx_chart_dd_val, title="Double Dragon Bar, MCDX+12", style=plot.style_columns, linewidth=2, color=color.orange)
plotshape(mcdx_chart_dd_val, title="Double Dragon Icon, MCDX+12 ", style=shape.diamond, location=location.absolute, color=color.orange, text='D'+'\nD', textcolor=color.black, size=size.tiny)
dd_line = mcdx_chart_dd and mcdx12== true? line.new(bar_index, close, bar_index+20, close, color=color.orange, width=2,  force_overlay = true) :na

mcd_chart_dd = mcd_dd_con and mcdx_dd_con
mcd_chart_dd_val = mcd_chart_dd and mcd_plot == true? 75 : na 
plot(mcd_chart_dd_val, title="Double Dragon Bar, MCD", style=plot.style_columns, linewidth=2, color=color.orange)
plotshape(mcd_chart_dd_val, title="Double Dragon Icon, MCD ", style=shape.diamond, location=location.absolute, color=color.orange, text='D'+'\nD', textcolor=color.black, size=size.tiny)

var label dd_label2 = na
if mcdx_chart_dd and mcdx12== true and mcdx_plot == true
    // Delete previous label if it exists
    // if not na(dd_label2)
    //     label.delete(dd_label2)
    // 
    // Create the latest label with text
    dd_label2 := label.new(bar_index, low, text = 'D'+'\nD',color = color.new(color.orange,80), style = label.style_label_up, textcolor = color.black,  textalign = text.align_left, size = size.small, force_overlay = true)
