# AI Stock Analyzer Configuration
# Copy this file to .env and fill in your credentials

# Get your credentials from: https://aimiai.com/console (API Keys tab)
AIMIAI_APP_ID=your_app_id_here
AIMIAI_APP_KEY=your_app_key_here

# Optional: Override default API endpoints
# AIMIAI_TOKEN_URL=https://aimiai.com/api/token/get
# AIMIAI_ANALYSIS_URL=https://aimiai.com/api/analysis
